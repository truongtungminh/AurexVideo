{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AurexVideo",
  "version": "0.2.4",
  "identifier": "app.aurexvideo",
  "build": {
    "frontendDist": "../engine/web",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AurexVideo",
        "url": "http://127.0.0.1:4173",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": []
    }
  }
}
